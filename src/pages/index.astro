---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experiences } from '../data/experience';
import { skillCategories } from '../data/skills';
import { projects } from '../data/projects';
import { profile, stats } from '../data/profile';
import { ArrowUpRight, Github, Linkedin, Mail, MapPin, Phone } from 'lucide-astro';

const siteUrl = 'https://portfolio.dinhkien.id.vn';
const pageTitle = 'Ha Dinh Kien | Full Stack Engineer';
const pageDescription = 'Full stack engineer in Ho Chi Minh City specializing in applied AI — production systems with Python, Django, FastAPI, React, and TypeScript, including RAG assistants and Model Context Protocol integrations.';
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: 'Full Stack Engineer',
  url: siteUrl,
  image: `${siteUrl}${profile.portrait}`,
  email: `mailto:${profile.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ho Chi Minh City',
    addressCountry: 'VN'
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'VNU-HCM University of Information Technology'
  },
  sameAs: [profile.github, profile.linkedin]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/"
  jsonLd={personJsonLd}
>
  <!-- ─── Hero ─────────────────────────────────────────── -->
  <header id="top" class="hero">
    <div class="shell hero-inner">
      <div class="hero-copy">
        <div class="badge">
          <span class="badge-dot" aria-hidden="true"></span>
          {profile.status}
        </div>

        <h1 class="hero-title">{profile.name}</h1>
        <p class="hero-role">{profile.role}</p>
        <p class="hero-bio">{profile.bio}</p>

        <div class="hero-actions">
          <a href={`mailto:${profile.email}`} class="button button-primary">
            <Mail size={15} />
            Get in touch
          </a>
          <a href={profile.github} target="_blank" rel="noopener noreferrer" class="button button-secondary">
            <Github size={15} />
            GitHub
          </a>
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="button button-secondary">
            <Linkedin size={15} />
            LinkedIn
          </a>
        </div>

        <div class="stat-row">
          {stats.map(stat => (
            <div>
              <p class="stat-value">{stat.value}</p>
              <p class="stat-label">{stat.label}</p>
            </div>
          ))}
        </div>

        <div class="meta-row">
          <span class="meta-item"><MapPin size={13} />{profile.location}</span>
          <span class="meta-item"><Phone size={13} />{profile.phone}</span>
          <span class="meta-item"><Mail size={13} />{profile.email}</span>
        </div>
      </div>

      <div style="flex-shrink: 0;">
        <img
          src={profile.portrait}
          alt={profile.name}
          width="720"
          height="1047"
          class="hero-portrait"
        />
      </div>
    </div>
  </header>

  <!-- ─── 01 Experience ────────────────────────────────── -->
  <section id="experience" data-section="experience" class="section">
    <div class="shell section-inner" style="padding-bottom: 24px;">
      <p class="section-eyebrow">01 — Experience</p>
      <h2 class="section-title">Where I've worked</h2>
      <p class="section-lead">
        Applied-AI and platform engineering across multi-tenant SaaS and real-time UAV systems.
      </p>

      {experiences.map((exp, index) => (
        <div class="entry-row" data-reveal data-delay={index * 60}>
          <div class="entry-aside">
            <p class="entry-date">{exp.startDate} — {exp.endDate}</p>
            <p class="entry-place">{exp.location}</p>
          </div>

          <div class="entry-body">
            <h3 class="entry-title">
              {exp.role}
              <span class="entry-org"> · {exp.company}</span>
            </h3>
            {exp.note && <p class="entry-note">{exp.note}</p>}

            <div class="bullet-list">
              {exp.highlights.map(highlight => (
                <div class="bullet"><span>{highlight}</span></div>
              ))}
            </div>

            <div class="chip-row">
              {exp.techStack.map(tech => (
                <span class="chip chip-mono">{tech}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ─── 02 Projects ──────────────────────────────────── -->
  <section id="projects" data-section="projects" class="section">
    <div class="shell section-inner">
      <p class="section-eyebrow">02 — Projects</p>
      <h2 class="section-title">Selected work</h2>
      <p class="section-lead">
        Systems I designed and shipped end to end, from retrieval pipelines to real-time telemetry.
      </p>

      <div class="project-grid">
        {projects.map((project, index) => (
          <article class="card" data-reveal data-delay={index * 50}>
            <h3 class="card-title">{project.title}</h3>
            <p class="card-body">{project.description}</p>
            <div class="chip-row">
              {project.techStack.map(tech => (
                <span class="chip chip-mono">{tech}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── 03 Skills ────────────────────────────────────── -->
  <section id="skills" data-section="skills" class="section">
    <div class="shell section-inner">
      <p class="section-eyebrow">03 — Skills</p>
      <h2 class="section-title">Technical toolkit</h2>
      <p class="section-lead">The stack I reach for when building and operating production systems.</p>

      <div class="skill-grid">
        {skillCategories.map((category, index) => (
          <div class="skill-card" data-reveal data-delay={index * 40}>
            <p class="skill-card-title">{category.category}</p>
            <div class="chip-row">
              {category.skills.map(skill => (
                <span class="chip">{skill}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── 04 Education ─────────────────────────────────── -->
  <section id="education" data-section="education" class="section">
    <div class="shell section-inner">
      <p class="section-eyebrow">04 — Education</p>
      <h2 class="section-title">Background</h2>

      <div class="entry-row" data-reveal>
        <div class="entry-aside">
          <p class="entry-date">Sep 2021 — Jun 2025</p>
          <p class="entry-place">Ho Chi Minh City</p>
        </div>
        <div class="entry-body">
          <h3 class="entry-title">
            VNU-HCM University of Information Technology
            <span class="entry-org"> · Information Technology</span>
          </h3>
          <div class="bullet-list">
            <div class="bullet"><span><strong>Cumulative GPA</strong> — 8.38 / 10.0</span></div>
            <div class="bullet"><span>Coursework across operating systems, computer networks, data structures and algorithms, OOP, and web development.</span></div>
          </div>
        </div>
      </div>

      <div class="entry-row" data-reveal data-delay="60">
        <div class="entry-aside">
          <p class="entry-date">Languages</p>
          <p class="entry-place">English</p>
        </div>
        <div class="entry-body">
          <h3 class="entry-title">TOEIC</h3>
          <div class="score-list" style="margin-top: 16px;">
            <div class="score-row"><span>Listening &amp; Reading</span><span>770</span></div>
            <div class="score-row"><span>Speaking &amp; Writing</span><span>250</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 05 Contact ───────────────────────────────────── -->
  <section id="contact" data-section="contact" class="section">
    <div class="shell contact-inner">
      <p class="section-eyebrow">05 — Contact</p>
      <h2 class="contact-title">Let's build something together.</h2>
      <p class="contact-lead">
        I'm open to full stack and applied-AI roles, and to interesting collaborations. My inbox is always open.
      </p>
      <div class="contact-actions">
        <a href={`mailto:${profile.email}`} class="button button-primary">
          {profile.email}
          <ArrowUpRight size={14} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
